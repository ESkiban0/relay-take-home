PORT=3000
MYSQL_URL=mysql://root:root@mysql:3306/relay?charset=utf8mb4
MONGO_URL=mongodb://mongo:27017/relay
REDIS_URL=redis://redis:6379

# 'sql' (MySQL + Mongo) or 'memory'. 'memory' is single-process and volatile —
# it exists for the test suite and `npm run dev:memory`, never for the stack.
STORE_DRIVER=sql
# 'sql' uses Redis for pub/sub and rate limiting; 'memory' keeps both in
# process, which is only correct with exactly one API instance.
BROKER_DRIVER=sql

# Sends allowed per user, per conversation, per window.
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_MS=10000

MESSAGE_PAGE_SIZE=50
MAX_MESSAGE_LENGTH=4000
SEARCH_LIMIT=50
TYPING_TTL_MS=4000
