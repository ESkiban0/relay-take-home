{
  "name": "relay",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "cp -n .env.example .env && npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "relay", "onAutoForward": "notify" }
  }
}
